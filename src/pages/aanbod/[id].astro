---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../config';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const trainingen = await getCollection('trainingen');
  return trainingen.map((training) => ({ params: { id: training.id }, props: { training } }));
}

const { training } = Astro.props;
const { Content } = await render(training);
const d = training.data;

const feiten = [
  { label: 'Voor wie', waarde: d.doelgroep },
  { label: 'Duur', waarde: d.duur },
  { label: 'Vorm', waarde: d.vorm.join(', ') },
  { label: 'Groepsgrootte', waarde: d.groepsgrootte },
  { label: 'Investering', waarde: d.prijsindicatie },
];
---

<Base title={d.titel} description={d.samenvatting}>
  <section class="section kop">
    <div class="container">
      <p class="zacht"><a href={url('aanbod/')}>Trainingen</a></p>
      <h1>{d.titel}</h1>
      <p class="intro">{d.ondertitel}</p>
    </div>
  </section>

  <section class="section section--groen feiten-sectie">
    <div class="container">
      <dl class="feiten">
        {
          feiten.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.waarde}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="prose">
        <Content />
        {
          d.startdata.length > 0 && (
            <>
              <h2>Startdata</h2>
              <ul>
                {d.startdata.map((s) => <li>{s}</li>)}
              </ul>
            </>
          )
        }
        <div class="aanvragen">
          <a class="button" href={url(`contact/?training=${training.id}`)}>Offerte aanvragen</a>
          <p class="zacht">Of mail naar <a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .kop { padding-bottom: var(--space-l); }
  .kop h1 { max-width: 18ch; }
  .kop .zacht a { color: inherit; }

  .feiten-sectie { padding-block: var(--space-l); }
  .feiten {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-m);
    margin: 0;
  }
  .feiten dt { color: var(--ink-soft); font-size: var(--step--1); }
  .feiten dd { margin: 0; }

  .prose :global(blockquote) { margin: 0 0 var(--space-m); color: var(--ink-soft); font-style: italic; }
  .prose :global(blockquote p) { margin: 0; }

  .aanvragen { margin-top: var(--space-l); }
  .aanvragen .zacht { margin-top: var(--space-s); }
</style>
