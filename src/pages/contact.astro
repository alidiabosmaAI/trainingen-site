---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../config';
import { url } from '../lib/url';

const trainingen = (await getCollection('trainingen')).sort((a, b) => a.data.volgorde - b.data.volgorde);
const bedankt = new URL(url('bedankt/'), Astro.site).href;
---

<Base title="Contact" description="Vraag een offerte aan of plan een kennismaking.">
  <section class="section">
    <div class="container layout">
      <div>
        <p class="label">Contact</p>
        <h1>Offerte of kennismaking</h1>
        <p class="intro">Vertel kort wat je zoekt. Je hoort binnen twee werkdagen van mij.</p>
        <p>Liever direct mailen? <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>

      <form class="form" method="post" action={site.formAction || undefined}>
        {!site.formAction && (
          <p class="form__note" role="note">Formulier is nog niet gekoppeld aan een verzenddienst.</p>
        )}
        <input type="hidden" name="_subject" value="Nieuwe aanvraag via bestuurskundigleerhuis.nl" />
        <input type="hidden" name="_next" value={bedankt} />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />
        <!-- Verborgen veld tegen spam: mensen zien het niet, bots vullen het in -->
        <input type="text" name="_honey" class="form__honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label>Naam <input name="naam" autocomplete="name" required /></label>
        <label>Organisatie <input name="organisatie" autocomplete="organization" required /></label>
        <label>E-mailadres <input type="email" name="email" autocomplete="email" required /></label>
        <label>
          Interesse in
          <select name="training" id="training">
            <option value="Nog niet bekend / maatwerk">Nog niet bekend / maatwerk</option>
            {trainingen.map((t) => <option value={t.data.titel} data-id={t.id}>{t.data.titel}</option>)}
          </select>
        </label>
        <label>Aantal deelnemers (indicatie) <input name="deelnemers" inputmode="numeric" /></label>
        <label>Je vraag <textarea name="bericht" rows="5" required></textarea></label>
        <button class="button button--accent" type="submit">Versturen</button>
        <p class="form__privacy">
          Ik gebruik je gegevens alleen om je aanvraag te beantwoorden. Lees ook de <a href={url('privacy/')}>privacyverklaring</a>.
        </p>
      </form>
    </div>
  </section>
</Base>

<script>
  // Vul de gekozen training in als iemand via een trainingspagina komt.
  const gekozen = new URLSearchParams(location.search).get('training');
  const select = document.getElementById('training') as HTMLSelectElement | null;
  const optie = select?.querySelector<HTMLOptionElement>(`option[data-id="${gekozen}"]`);
  if (optie) optie.selected = true;
</script>

<style>
  .layout { display: grid; grid-template-columns: 1fr 1.2fr; gap: var(--space-xl); align-items: start; }
  .form { display: grid; gap: var(--space-s); background: var(--perzik); padding: var(--space-l); }
  .form label { display: grid; gap: 0.3rem; font-weight: 500; }
  .form input, .form select, .form textarea {
    font: inherit;
    font-weight: 300;
    padding: 0.75em 0.9em;
    border: 1.5px solid transparent;
    border-bottom-color: var(--ink);
    background: var(--white);
    color: var(--ink);
  }
  .form input:focus, .form select:focus, .form textarea:focus { border-color: var(--ink); outline: none; }
  .form .button { justify-self: start; cursor: pointer; font: inherit; font-weight: 500; }
  .form__note { background: var(--white); border-left: 4px solid var(--oker); padding: 0.6em 1em; margin: 0; font-size: var(--step--1); }
  .form__privacy { font-size: var(--step--1); margin: 0; }
  .form__honey { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  @media (max-width: 56rem) { .layout { grid-template-columns: 1fr; gap: var(--space-l); } .form { padding: var(--space-m); } }
</style>
