---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Bedankt" description="Je bericht is verstuurd." noindex>
  <section class="section">
    <div class="container prose">
      <p class="label">Contact</p>
      <h1>Bedankt voor je bericht</h1>
      <p class="intro">Je aanvraag is verstuurd. Je hoort binnen twee werkdagen van mij.</p>
      <p><a class="button" href={url()}>Terug naar de homepage</a></p>
    </div>
  </section>
</Base>
