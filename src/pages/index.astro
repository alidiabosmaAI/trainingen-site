---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Tegels from '../components/Tegels.astro';
import Artikel from '../components/Artikel.astro';
import TrainingCard from '../components/TrainingCard.astro';
import { site } from '../config';
import { url } from '../lib/url';

const trainingen = (await getCollection('trainingen')).sort((a, b) => a.data.volgorde - b.data.volgorde);

const stappen = [
  { titel: 'Kennismaken', tekst: 'We bespreken jullie vraag, de doelgroep en waar jullie staan.' },
  { titel: 'Voorstel op maat', tekst: 'Een offerte met programma, planning en een vaste prijs.' },
  { titel: 'Training', tekst: 'Met simulaties en games waarin deelnemers zelf beslissingen nemen.' },
  { titel: 'Borgen', tekst: 'Evaluatie, naslagmateriaal en eventuele vervolgstappen.' },
];
const stapKleuren = ['var(--oker)', 'var(--salie)', 'var(--perzik)', 'var(--hemel)'];

const leervormen = [
  {
    titel: 'Simulaties',
    tekst: 'Deelnemers doorlopen een besluitvormingsproces waarin een algoritme meebeslist, en ervaren zelf waar het schuurt.',
    kleur: 'var(--oker)',
    vorm: '100% 0 0 0',
  },
  {
    titel: 'Games',
    tekst: 'Met spelvormen oefenen deelnemers begrippen en dilemma’s. Actief, met elkaar en met ruimte voor fouten.',
    kleur: 'var(--denim)',
    vorm: '50%',
  },
  {
    titel: 'Vertaling naar de praktijk',
    tekst: 'Na elke ronde vertalen we wat er gebeurde naar het eigen werk. Een eigen casus inbrengen kan ook.',
    kleur: 'var(--ink)',
    vorm: '0 0 100% 0',
  },
];

const doelgroepen = [
  { naam: 'Gemeenten en provincies', toelichting: 'Beleid, uitvoering en bestuur' },
  { naam: 'Rijksoverheid en uitvoeringsorganisaties', toelichting: 'Van beleidsdirectie tot dienstverlening' },
  { naam: 'Woningcorporaties', toelichting: 'Toewijzing, onderhoud en huurdersdienstverlening' },
  { naam: 'Waterschappen en andere publieke organisaties', toelichting: 'Iedere organisatie met een publieke taak' },
];
---

<Base>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <p class="label">AI-geletterdheid & algoritmisch bestuur</p>
        <h1>Grip op AI in de publieke sector</h1>
        <p class="intro">
          Trainingen in AI-geletterdheid voor overheden en woningcorporaties. Met simulaties en games, zodat
          deelnemers ervaren wat er op het spel staat.
        </p>
        <div class="hero__actions">
          <a class="button" href={url('aanbod/')}>Bekijk het aanbod</a>
          <a class="button button--outline" href={url('contact/')}>Plan een kennismaking</a>
        </div>
      </div>
      <div class="hero__visual">
        <Tegels variant="a" />
      </div>
    </div>
  </section>

  <section class="section section--papier">
    <div class="container visie">
      <div>
        <p class="label" style="--label-kleur: var(--olijf)">Visie</p>
        <h2>AI-geletterdheid is ambtelijk vakmanschap</h2>
        <p>
          De overheid zet steeds vaker algoritmes in voor taken die burgers en huurders direct raken. Begrijpen wat
          er gebeurt is daarom geen specialisme voor IT, maar een basiscompetentie voor iedere ambtenaar.
        </p>
        <p>
          Een algoritme is nooit neutraal. Publieke waarden zijn de maatstaf, niet alleen efficiëntie. En de mens
          blijft verantwoordelijk voor het besluit.
        </p>
        <p class="visie__link"><a href={url('visie/')}>Lees mijn visie →</a></p>
      </div>
      <Artikel kop="Artikel 4 · AI-geletterdheid" bron="AI-verordening (EU) 2024/1689, van toepassing sinds 2 februari 2025">
        <p>
          Aanbieders en gebruiksverantwoordelijken van AI-systemen nemen maatregelen om, zoveel als mogelijk, te
          zorgen voor een <mark>toereikend niveau van AI-geletterdheid</mark> bij hun personeel en andere personen
          die namens hen AI-systemen exploiteren en gebruiken […]
        </p>
      </Artikel>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label" style="--label-kleur: var(--oker)">Aanpak</p>
      <h2>Leren door te doen</h2>
      <p class="intro">Serieus van inhoud, speels in de vorm. Geen lange presentaties, maar zelf ervaren wat AI doet in het openbaar bestuur.</p>
      <ul class="leervormen">
        {
          leervormen.map((l) => (
            <li>
              <span class="leervormen__vorm" style={`background: ${l.kleur}; border-radius: ${l.vorm}`} aria-hidden="true" />
              <h3>{l.titel}</h3>
              <p>{l.tekst}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--papier">
    <div class="container">
      <p class="label" style="--label-kleur: var(--koper)">Aanbod</p>
      <h2>Drie rollen, drie trainingen</h2>
      <p class="intro">Voor de professional die met AI werkt, de adviseur die algoritmes beoordeelt en de leidinggevende die richting geeft.</p>
      <div class="panels">
        {trainingen.map((t) => <TrainingCard training={t} />)}
      </div>
      <div class="panels__maatwerk">
        <p><strong>Niet gevonden wat je zoekt?</strong> Maatwerk is altijd mogelijk.</p>
        <a class="button button--outline" href={url('contact/')}>Bespreek je vraag</a>
      </div>
    </div>
  </section>

  <section class="section section--salie">
    <div class="container">
      <p class="label" style="--label-kleur: var(--ink)">Voor wie</p>
      <h2>Voor organisaties met een publieke taak</h2>
      <ul class="doelgroepen">
        {
          doelgroepen.map((d) => (
            <li>
              <h3>{d.naam}</h3>
              <p>{d.toelichting}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label" style="--label-kleur: var(--olijf)">Werkwijze</p>
      <h2>Van eerste gesprek tot blijvend resultaat</h2>
      <ol class="stappen">
        {
          stappen.map((s, i) => (
            <li>
              <span class="stappen__nr" style={`background: ${stapKleuren[i]}`} aria-hidden="true">
                {i + 1}
              </span>
              <h3>{s.titel}</h3>
              <p>{s.tekst}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--papier">
    <div class="container over">
      <div class="over__visual">
        <Tegels variant="b" />
      </div>
      <div>
        <p class="label" style="--label-kleur: var(--olijf)">Over</p>
        <h2>{site.name}</h2>
        <p>
          Ik ben bestuurskundige en docent aan De Haagse Hogeschool, en werkte eerder als beleidsadviseur bij
          gemeenten. Ik studeerde af op leertransfer van AI-geletterdheid bij startende ambtenaren: wat leren zij, en
          wat nemen ze daarvan mee naar de werkvloer? Die kennis vertaal ik naar trainingen die serieus zijn van
          inhoud en speels in de vorm.
        </p>
        <p><a href={url('over/')}>Lees meer over mij</a></p>
        <div class="over__contact">
          <a class="button button--accent" href={url('contact/')}>Kennismaken?</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: var(--space-xl); }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }
  .hero h1 { max-width: 14ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-s); margin-top: var(--space-m); }
  .hero__visual { max-width: 26rem; justify-self: end; width: 100%; }

  .visie { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-xl); align-items: center; }

  .panels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-m);
    margin-top: var(--space-l);
  }
  .visie__link { font-weight: 700; }
  .leervormen {
    list-style: none;
    margin: var(--space-l) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-l);
  }
  .leervormen__vorm { display: block; width: 3rem; height: 3rem; margin-bottom: var(--space-m); }
  .leervormen h3 { font-size: var(--step-1); margin-bottom: var(--space-xs); }
  .leervormen p { margin: 0; }

  .panels__maatwerk {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: var(--space-m);
    padding: var(--space-m) var(--space-l);
    background: var(--white);
    border-radius: var(--radius);
  }
  .panels__maatwerk p { margin: 0; }

  .doelgroepen {
    list-style: none;
    margin: var(--space-l) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m) var(--space-l);
  }
  .doelgroepen h3 { font-size: var(--step-1); margin-bottom: 0.2rem; }
  .doelgroepen p { margin: 0; }

  .stappen {
    list-style: none;
    margin: var(--space-l) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-m);
  }
  .stappen__nr {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius);
    font-weight: 800;
    font-size: var(--step-1);
    margin-bottom: var(--space-s);
  }
  .stappen h3 { font-size: var(--step-1); margin-bottom: var(--space-xs); }

  .over { display: grid; grid-template-columns: 1fr 1.4fr; gap: var(--space-xl); align-items: center; }
  .over__visual { max-width: 24rem; }
  .over__contact { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-m); margin-top: var(--space-m); }

  @media (max-width: 56rem) {
    .leervormen { grid-template-columns: 1fr; gap: var(--space-m); }
    .hero__grid, .visie, .over { grid-template-columns: 1fr; gap: var(--space-l); }
    .hero__visual { justify-self: start; max-width: 18rem; }
    .stappen { grid-template-columns: 1fr 1fr; }
    .doelgroepen { grid-template-columns: 1fr; }
  }
  @media (max-width: 32rem) {
    .stappen { grid-template-columns: 1fr; }
    .panels__maatwerk { padding: var(--space-m); }
  }
</style>
