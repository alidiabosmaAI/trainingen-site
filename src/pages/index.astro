---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import { site } from '../config';
import { url } from '../lib/url';

const trainingen = (await getCollection('trainingen')).sort((a, b) => a.data.volgorde - b.data.volgorde);
---

<Base>
  <section class="section hero">
    <div class="container">
      <h1>Grip op AI in de publieke sector</h1>
      <p class="intro">Trainingen in AI-geletterdheid en algoritmisch bestuur, voor overheden en woningcorporaties.</p>
      <a class="button" href={url('aanbod/')}>Bekijk het aanbod</a>
    </div>
  </section>

  <section class="section section--groen">
    <div class="container">
      <p class="statement">
        Sinds februari 2025 vraagt de AI-verordening dat organisaties zorgen voor voldoende AI-geletterdheid bij
        hun medewerkers.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Trainingen</h2>
      <ul class="aanbod">
        {
          trainingen.map((t) => (
            <li>
              <h3><a href={url(`aanbod/${t.id}/`)}>{t.data.titel}</a></h3>
              <p>{t.data.samenvatting}</p>
              <p class="zacht">{t.data.duur} · {t.data.vorm.join(', ')}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container over">
      <div class="over__foto"><Foto /></div>
      <div>
        <h2>Over {site.name}</h2>
        <p>[Voorbeeldtekst: twee of drie zinnen over je achtergrond in algoritmisch bestuur.]</p>
        <p><a href={url('over/')}>Meer over mij</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Kennismaken?</h2>
      <p class="intro">Vertel me wat jullie zoeken, dan denk ik graag mee.</p>
      <a class="button" href={url('contact/')}>Neem contact op</a>
    </div>
  </section>
</Base>

<style>
  .hero h1 { max-width: 14ch; }
  .hero .intro { margin-bottom: var(--space-m); }

  .statement {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.3;
    max-width: 30ch;
    margin: 0;
  }

  .aanbod {
    list-style: none;
    margin: var(--space-l) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-l);
    max-width: 44rem;
  }
  .aanbod h3 { margin-bottom: 0.5rem; }
  .aanbod h3 a { text-decoration: none; }
  .aanbod h3 a:hover { text-decoration: underline; }
  .aanbod p { margin-bottom: 0.25rem; }

  .over { display: grid; grid-template-columns: 18rem 1fr; gap: var(--space-l); align-items: center; }
  .over > div:last-child { max-width: 34rem; }

  @media (max-width: 48rem) {
    .over { grid-template-columns: 1fr; gap: var(--space-m); }
    .over__foto { max-width: 14rem; }
  }
</style>
