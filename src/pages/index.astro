---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Tegels from '../components/Tegels.astro';
import TrainingCard from '../components/TrainingCard.astro';
import Artikel from '../components/Artikel.astro';
import Werkwijze from '../components/Werkwijze.astro';
import { site } from '../config';
import { url } from '../lib/url';

const trainingen = (await getCollection('trainingen')).sort((a, b) => a.data.volgorde - b.data.volgorde);
---

<Base>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <p class="label">AI-geletterdheid & algoritmisch bestuur</p>
        <h1>Grip op AI in de publieke sector</h1>
        <p class="intro">
          Trainingen in AI-geletterdheid voor overheden en semi-publieke organisaties. Met simulaties en games, zodat
          deelnemers ervaren wat er op het spel staat.
        </p>
        <div class="hero__actions">
          <a class="button" href={url('#werkwijze')}>Zo werkt het</a>
          <a class="button button--outline" href={url('aanbod/')}>Bekijk het aanbod</a>
        </div>
      </div>
      <div class="hero__visual">
        <Tegels variant="a" />
      </div>
    </div>
  </section>

  <section class="section section--papier" id="werkwijze">
    <div class="container">
      <p class="label" style="--label-kleur: var(--oker)">Werkwijze</p>
      <h2>Zo werkt het</h2>
      <p class="intro">
        Serieus van inhoud, speels in de vorm. Elke training stemmen we af op jullie organisatie: op de vraag, de
        deelnemers en de manier van leren die bij jullie past.
      </p>
      <Werkwijze />
      <p class="meer"><a href={url('werkwijze/')}>Meer over de werkwijze →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label" style="--label-kleur: var(--koper)">Aanbod</p>
      <h2>Drie rollen, drie trainingen</h2>
      <p class="intro">Voor de professional die met AI werkt, de adviseur die algoritmes beoordeelt en de leidinggevende die richting geeft.</p>
      <div class="panels">
        {trainingen.map((t) => <TrainingCard training={t} />)}
      </div>
      <p class="maatwerk">Niet gevonden wat je zoekt? <a href={url('contact/')}>Maatwerk is altijd mogelijk.</a></p>
    </div>
  </section>

  <section class="section section--papier">
    <div class="container visie">
      <div>
        <p class="label" style="--label-kleur: var(--olijf)">Visie</p>
        <h2>In elk algoritme zitten keuzes</h2>
        <p>
          Wie krijgt een toeslag? Welke aanvraag wordt extra gecontroleerd? Achter zulke uitkomsten zitten opvattingen
          over gelijke behandeling, privacy en de menselijke maat. Wie die herkent, kan ze bespreken en bijsturen.
        </p>
        <p>
          Sinds 2 februari 2025 is AI-geletterdheid bovendien verplicht voor iedere organisatie die AI inzet.
        </p>
        <p class="meer"><a href={url('visie/')}>Lees mijn visie →</a></p>
      </div>
      <Artikel kop="Artikel 4 · AI-geletterdheid" bron="AI-verordening (EU) 2024/1689, van toepassing sinds 2 februari 2025">
        <p>
          Aanbieders en gebruiksverantwoordelijken van AI-systemen nemen maatregelen om, zoveel als mogelijk, te
          zorgen voor een <mark>toereikend niveau van AI-geletterdheid</mark> bij hun personeel en andere personen
          die namens hen AI-systemen exploiteren en gebruiken […]
        </p>
      </Artikel>
    </div>
  </section>

  <section class="section section--salie">
    <div class="container slot">
      <div>
        <h2>Kennismaken?</h2>
        <p class="intro">Vertel me wat jullie zoeken, dan stemmen we samen de werkvorm af.</p>
      </div>
      <div class="slot__acties">
        <a class="button" href={url('contact/')}>Neem contact op</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: var(--space-xl); }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }
  .hero h1 { max-width: 14ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-s); margin-top: var(--space-m); }
  .hero__visual { max-width: 26rem; justify-self: end; width: 100%; }

  #werkwijze .intro { max-width: 52ch; }
  .meer { margin: var(--space-m) 0 0; font-weight: 700; }

  .panels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-m);
    margin-top: var(--space-l);
  }
  .maatwerk { margin: var(--space-m) 0 0; }

  .visie { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-xl); align-items: center; }

  .slot { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-m); }
  .slot .intro { margin: 0; }
  .slot__acties { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-m); }

  @media (max-width: 56rem) {
    .hero__grid, .visie { grid-template-columns: 1fr; gap: var(--space-l); }
    .hero__visual { justify-self: start; max-width: 18rem; }
  }
</style>
