---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Tegels from '../components/Tegels.astro';
import Artikel from '../components/Artikel.astro';
import TrainingCard from '../components/TrainingCard.astro';
import { site } from '../config';
import { url } from '../lib/url';

const trainingen = (await getCollection('trainingen')).sort((a, b) => a.data.volgorde - b.data.volgorde);

const stappen = [
  { titel: 'Kennismaken', tekst: 'We bespreken jullie vraag, de doelgroep en waar jullie staan.' },
  { titel: 'Voorstel op maat', tekst: 'Een offerte met programma, planning en een vaste prijs.' },
  { titel: 'Training', tekst: 'Interactief, met spelvormen en casussen uit jullie eigen praktijk.' },
  { titel: 'Borgen', tekst: 'Evaluatie, naslagmateriaal en eventuele vervolgstappen.' },
];
const stapKleuren = ['var(--oker)', 'var(--salie)', 'var(--perzik)', 'var(--hemel)'];

const doelgroepen = [
  { naam: 'Gemeenten en provincies', toelichting: 'Beleid, uitvoering en bestuur' },
  { naam: 'Rijksoverheid en uitvoeringsorganisaties', toelichting: 'Van beleidsdirectie tot dienstverlening' },
  { naam: 'Woningcorporaties', toelichting: 'Toewijzing, onderhoud en huurdersdienstverlening' },
  { naam: 'Waterschappen en andere publieke organisaties', toelichting: 'Iedere organisatie met een publieke taak' },
];
---

<Base>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <p class="label">AI-geletterdheid & algoritmisch bestuur</p>
        <h1>Grip op AI in de publieke sector</h1>
        <p class="intro">
          Trainingen voor organisaties die AI verantwoord willen inzetten. Helder uitgelegd, inhoudelijk
          onderbouwd en afgestemd op jullie praktijk.
        </p>
        <div class="hero__actions">
          <a class="button" href={url('aanbod/')}>Bekijk het aanbod</a>
          <a class="button button--outline" href={url('contact/')}>Plan een kennismaking</a>
        </div>
      </div>
      <div class="hero__visual">
        <Tegels variant="a" />
      </div>
    </div>
  </section>

  <section class="section section--papier">
    <div class="container visie">
      <div>
        <p class="label" style="--label-kleur: var(--olijf)">Visie</p>
        <h2>AI begrijpen is de basis voor goed bestuur</h2>
        <p>
          Algoritmes en AI ondersteunen steeds vaker beslissingen die burgers en huurders direct raken. Dat vraagt
          om medewerkers en bestuurders die weten wat deze systemen doen, waar de risico's zitten en welke
          verantwoordelijkheid zij zelf dragen.
        </p>
        <p>
          Mijn trainingen maken dat begrijpelijk, zonder hype en zonder onnodig jargon. Serieus van inhoud, met
          diepgaande kennis van algoritmisch bestuur en de AI-verordening. Speels in de vorm: deelnemers oefenen
          met begrippen in spelvormen en werken aan casussen uit hun eigen praktijk, in plaats van te luisteren naar
          een lange presentatie.
        </p>
      </div>
      <Artikel kop="Artikel 4 · AI-geletterdheid" bron="AI-verordening (EU) 2024/1689, van toepassing sinds 2 februari 2025">
        <p>
          Aanbieders en gebruiksverantwoordelijken van AI-systemen nemen maatregelen om, zoveel als mogelijk, te
          zorgen voor een <mark>toereikend niveau van AI-geletterdheid</mark> bij hun personeel en andere personen
          die namens hen AI-systemen exploiteren en gebruiken […]
        </p>
      </Artikel>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label" style="--label-kleur: var(--koper)">Aanbod</p>
      <h2>Trainingen</h2>
      <p class="intro">Alle trainingen zijn incompany te boeken en worden afgestemd op jullie organisatie.</p>
      <div class="panels">
        {trainingen.map((t) => <TrainingCard training={t} />)}
      </div>
      <div class="panels__maatwerk">
        <p><strong>Niet gevonden wat je zoekt?</strong> Maatwerk is altijd mogelijk.</p>
        <a class="button button--outline" href={url('contact/')}>Bespreek je vraag</a>
      </div>
    </div>
  </section>

  <section class="section section--salie">
    <div class="container">
      <p class="label" style="--label-kleur: var(--ink)">Voor wie</p>
      <h2>Voor organisaties met een publieke taak</h2>
      <ul class="doelgroepen">
        {
          doelgroepen.map((d) => (
            <li>
              <h3>{d.naam}</h3>
              <p>{d.toelichting}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label" style="--label-kleur: var(--olijf)">Werkwijze</p>
      <h2>Van eerste gesprek tot blijvend resultaat</h2>
      <ol class="stappen">
        {
          stappen.map((s, i) => (
            <li>
              <span class="stappen__nr" style={`background: ${stapKleuren[i]}`} aria-hidden="true">
                {i + 1}
              </span>
              <h3>{s.titel}</h3>
              <p>{s.tekst}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--papier">
    <div class="container over">
      <div class="over__visual">
        <Tegels variant="b" />
      </div>
      <div>
        <p class="label" style="--label-kleur: var(--olijf)">Over</p>
        <h2>{site.name}</h2>
        <p>
          [Voorbeeldtekst: een korte introductie over je achtergrond in algoritmisch bestuur, je ervaring met
          overheden en corporaties, en waarom je deze trainingen geeft.]
        </p>
        <p><a href={url('over/')}>Lees meer over mij</a></p>
        <div class="over__contact">
          <a class="button button--accent" href={url('contact/')}>Kennismaken?</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: var(--space-xl); }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }
  .hero h1 { max-width: 14ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-s); margin-top: var(--space-m); }
  .hero__visual { max-width: 26rem; justify-self: end; width: 100%; }

  .visie { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-xl); align-items: center; }

  .panels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-m);
    margin-top: var(--space-l);
  }
  .panels__maatwerk {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: var(--space-m);
    padding: var(--space-m) var(--space-l);
    background: var(--papier);
    border-radius: var(--radius);
  }
  .panels__maatwerk p { margin: 0; }

  .doelgroepen {
    list-style: none;
    margin: var(--space-l) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m) var(--space-l);
  }
  .doelgroepen h3 { font-size: var(--step-1); margin-bottom: 0.2rem; }
  .doelgroepen p { margin: 0; }

  .stappen {
    list-style: none;
    margin: var(--space-l) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-m);
  }
  .stappen__nr {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius);
    font-weight: 800;
    font-size: var(--step-1);
    margin-bottom: var(--space-s);
  }
  .stappen h3 { font-size: var(--step-1); margin-bottom: var(--space-xs); }

  .over { display: grid; grid-template-columns: 1fr 1.4fr; gap: var(--space-xl); align-items: center; }
  .over__visual { max-width: 24rem; }
  .over__contact { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-m); margin-top: var(--space-m); }

  @media (max-width: 56rem) {
    .hero__grid, .visie, .over { grid-template-columns: 1fr; gap: var(--space-l); }
    .hero__visual { justify-self: start; max-width: 18rem; }
    .stappen { grid-template-columns: 1fr 1fr; }
    .doelgroepen { grid-template-columns: 1fr; }
  }
  @media (max-width: 32rem) {
    .stappen { grid-template-columns: 1fr; }
    .panels__maatwerk { padding: var(--space-m); }
  }
</style>
