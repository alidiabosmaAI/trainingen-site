---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import DecisionTree from '../components/DecisionTree.astro';
import TrainingCard from '../components/TrainingCard.astro';
import { url } from '../lib/url';

const trainingen = (await getCollection('trainingen')).sort((a, b) => a.data.volgorde - b.data.volgorde);

const doelgroepen = [
  { naam: 'Gemeenten & provincies', kleur: 'var(--terracotta)' },
  { naam: 'Rijksoverheid & uitvoering', kleur: 'var(--saffraan)' },
  { naam: 'Woningcorporaties', kleur: 'var(--abrikoos)' },
  { naam: 'Waterschappen & publieke organisaties', kleur: 'var(--bosgroen)' },
];
---

<Base>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <p class="eyebrow">AI-geletterdheid · Algoritmisch bestuur</p>
        <h1>Grip op AI, met kennis van <em>publieke</em> besluitvorming.</h1>
        <p class="lead">
          Praktische trainingen voor organisaties die AI verantwoord willen inzetten. Helder uitgelegd,
          inhoudelijk onderbouwd en afgestemd op jullie praktijk.
        </p>
        <div class="hero__actions">
          <a class="button" href={url('aanbod/')}>Bekijk het aanbod</a>
          <a class="button button--ghost" href={url('contact/')}>Vrijblijvend kennismaken</a>
        </div>
      </div>
      <DecisionTree />
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="usp">
        <div>
          <p class="eyebrow">Waarom nu</p>
          <h2>AI-geletterdheid is geen keuze meer</h2>
          <p>
            Sinds 2 februari 2025 verplicht de AI-verordening organisaties om te zorgen dat medewerkers die met AI
            werken voldoende kennis en vaardigheden hebben. Maar het gaat om meer dan compliance: wie begrijpt hoe
            algoritmes besluiten beïnvloeden, neemt betere besluiten.
          </p>
        </div>
        <ul class="usp__list">
          <li><strong>Inhoudelijk</strong> Diepgaande kennis van algoritmisch bestuur en de AI-verordening.</li>
          <li><strong>Toegankelijk</strong> Geen jargon zonder uitleg. Iedereen kan meedoen.</li>
          <li><strong>Op maat</strong> Casussen uit jullie eigen organisatie en sector.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Aanbod</p>
      <div class="section__head">
        <h2>Trainingen</h2>
        <a href={url('aanbod/')}>Alle trainingen →</a>
      </div>
      <div class="cards">
        {trainingen.map((t) => <TrainingCard training={t} />)}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <p class="eyebrow">Voor wie</p>
      <h2>Voor organisaties met een publieke taak</h2>
      <ul class="chips">
        {doelgroepen.map((d) => <li style={`--chip: ${d.kleur}`}>{d.naam}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container cta">
      <h2>Benieuwd wat past bij jullie organisatie?</h2>
      <p>Plan een vrijblijvend kennismakingsgesprek. Samen bepalen we welke training aansluit bij jullie vraag.</p>
      <a class="button" href={url('contact/')}>Neem contact op</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-xl);
    background:
      radial-gradient(circle at 85% 20%, rgb(244 185 148 / 0.35), transparent 45%),
      radial-gradient(circle at 10% 90%, rgb(234 165 58 / 0.18), transparent 40%);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--space-l);
    align-items: center;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--terracotta-text);
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-s); margin-top: var(--space-m); }

  .usp { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-l); align-items: start; }
  .usp__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-s); }
  .usp__list li {
    background: var(--paper);
    border-radius: var(--radius);
    padding: var(--space-s) var(--space-m);
    border-left: 6px solid var(--bosgroen);
  }
  .usp__list li:nth-child(2) { border-left-color: var(--terracotta); }
  .usp__list li:nth-child(3) { border-left-color: var(--saffraan); }
  .usp__list strong { display: block; font-family: var(--font-display); font-size: var(--step-1); font-weight: 560; }

  .section__head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-m);
    margin-top: var(--space-m);
  }

  .chips { list-style: none; padding: 0; margin: var(--space-m) 0 0; display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .chips li {
    background: var(--chip);
    color: var(--ink);
    padding: 0.6em 1.2em;
    border-radius: 999px;
    font-weight: 600;
  }
  .chips li:nth-child(4) { color: var(--paper); }

  .cta {
    text-align: center;
    background: var(--ink);
    color: var(--paper);
    border-radius: calc(var(--radius) * 2);
    padding: var(--space-xl) var(--space-m);
    background-image: radial-gradient(rgb(251 246 238 / 0.12) 1.3px, transparent 1.3px);
    background-size: 18px 18px;
  }
  .cta p { max-width: 50ch; margin-inline: auto; margin-bottom: var(--space-m); opacity: 0.9; }
  .cta .button { background: var(--saffraan); border-color: var(--saffraan); color: var(--ink); }
  .cta .button:hover { background: var(--abrikoos); border-color: var(--abrikoos); }

  @media (max-width: 52rem) {
    .hero__grid, .usp { grid-template-columns: 1fr; }
    .hero__grid :global(.tree) { max-width: 26rem; }
  }
</style>
