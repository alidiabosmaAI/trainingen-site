---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BlockGrid from '../components/BlockGrid.astro';
import TrainingPanel from '../components/TrainingPanel.astro';
import { site } from '../config';
import { url } from '../lib/url';

const trainingen = (await getCollection('trainingen')).sort((a, b) => a.data.volgorde - b.data.volgorde);

const stappen = [
  { titel: 'Kennismaken', tekst: 'We bespreken jullie vraag, de doelgroep en waar jullie staan.' },
  { titel: 'Voorstel op maat', tekst: 'Een offerte met programma, planning en een vaste prijs.' },
  { titel: 'Training', tekst: 'Interactief, met casussen uit jullie eigen praktijk.' },
  { titel: 'Borgen', tekst: 'Evaluatie, naslagmateriaal en eventuele vervolgstappen.' },
];
const stapKleuren = ['var(--oranje)', 'var(--lila)', 'var(--mint)', 'var(--perzik)'];
---

<Base>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <p class="label">AI-geletterdheid & algoritmisch bestuur</p>
        <h1>Grip op AI in de publieke sector</h1>
        <p class="intro">
          Trainingen voor organisaties die AI verantwoord willen inzetten. Helder uitgelegd, inhoudelijk
          onderbouwd en afgestemd op jullie praktijk.
        </p>
        <div class="hero__actions">
          <a class="button" href={url('aanbod/')}>Bekijk het aanbod</a>
          <a class="button button--outline" href={url('contact/')}>Plan een kennismaking</a>
        </div>
      </div>
      <div class="hero__visual">
        <BlockGrid kleuren={['var(--oranje)', 'var(--perzik)', 'var(--lila)', 'var(--ink)']} fotoVak={1} />
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container visie">
      <div>
        <p class="label" style="--label-kleur: var(--groen)">Visie</p>
        <h2>AI begrijpen is de basis voor goed bestuur</h2>
      </div>
      <div>
        <p>
          Algoritmes en AI ondersteunen steeds vaker beslissingen die burgers en huurders direct raken. Dat vraagt
          om medewerkers en bestuurders die weten wat deze systemen doen, waar de risico's zitten en welke
          verantwoordelijkheid zij zelf dragen.
        </p>
        <p>
          Mijn trainingen maken dat begrijpelijk, zonder hype en zonder onnodig jargon. Met diepgaande kennis van
          algoritmisch bestuur en de AI-verordening, vertaald naar jullie dagelijkse praktijk.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label" style="--label-kleur: var(--vermiljoen)">Aanbod</p>
      <h2>Trainingen</h2>
      <p class="intro">Alle trainingen zijn incompany te boeken en worden afgestemd op jullie organisatie.</p>
      <div class="panels">
        {trainingen.map((t) => <TrainingPanel training={t} />)}
      </div>
      <div class="panels__maatwerk">
        <p><strong>Niet gevonden wat je zoekt?</strong> Maatwerk is altijd mogelijk.</p>
        <a class="button button--outline" href={url('contact/')}>Bespreek je vraag</a>
      </div>
    </div>
  </section>

  <section class="statement">
    <div class="container statement__grid">
      <div class="statement__blokken" aria-hidden="true">
        <span style="background: var(--ink)"></span>
        <span style="background: var(--oranje)"></span>
        <span></span>
        <span style="background: var(--white)"></span>
      </div>
      <p>
        Sinds 2 februari 2025 moeten organisaties die AI gebruiken zorgen voor{' '}
        <strong>voldoende AI-geletterdheid</strong> van hun medewerkers.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label" style="--label-kleur: var(--groen)">Werkwijze</p>
      <h2>Van eerste gesprek tot blijvend resultaat</h2>
      <ol class="stappen">
        {
          stappen.map((s, i) => (
            <li>
              <span class="stappen__nr" style={`background: ${stapKleuren[i]}`} aria-hidden="true">
                {i + 1}
              </span>
              <h3>{s.titel}</h3>
              <p>{s.tekst}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container over">
      <div class="over__visual">
        <BlockGrid kleuren={['var(--mint)', 'var(--lila)', 'var(--perzik)', 'var(--oranje)']} fotoVak={0} />
      </div>
      <div>
        <p class="label" style="--label-kleur: var(--lila)">Over</p>
        <h2>{site.name}</h2>
        <p>
          [Voorbeeldtekst: een korte introductie over je achtergrond in algoritmisch bestuur, je ervaring met
          overheden en corporaties, en waarom je deze trainingen geeft.]
        </p>
        <p><a href={url('over/')}>Lees meer over mij →</a></p>
        <div class="over__contact">
          <a class="button button--accent" href={url('contact/')}>Kennismaken?</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: var(--space-xl); }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }
  .hero h1 { max-width: 14ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-s); margin-top: var(--space-m); }
  .hero__visual { max-width: 26rem; justify-self: end; width: 100%; }

  .visie { display: grid; grid-template-columns: 1fr 1.3fr; gap: var(--space-l); }

  .panels { display: grid; gap: var(--space-m); margin-top: var(--space-l); }
  .panels__maatwerk {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: var(--space-m);
    padding: var(--space-m) var(--space-l);
    border: 2px solid var(--roos);
  }
  .panels__maatwerk p { margin: 0; }

  .statement { background: var(--mint); padding-block: var(--space-xl); }
  .statement__grid { display: grid; grid-template-columns: 10rem 1fr; gap: var(--space-xl); align-items: center; }
  .statement__blokken { display: grid; grid-template-columns: 1fr 1fr; }
  .statement__blokken span { aspect-ratio: 1; }
  .statement p { font-size: var(--step-2); line-height: 1.3; margin: 0; max-width: 28ch; }

  .stappen {
    list-style: none;
    margin: var(--space-l) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-m);
  }
  .stappen__nr {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    font-weight: 650;
    font-size: var(--step-1);
    margin-bottom: var(--space-s);
  }
  .stappen h3 { font-size: var(--step-1); margin-bottom: var(--space-xs); }

  .over { display: grid; grid-template-columns: 1fr 1.4fr; gap: var(--space-xl); align-items: center; }
  .over__visual { max-width: 24rem; }
  .over__contact { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-m); margin-top: var(--space-m); }

  @media (max-width: 56rem) {
    .hero__grid, .visie, .over { grid-template-columns: 1fr; gap: var(--space-l); }
    .hero__visual { justify-self: start; max-width: 18rem; }
    .stappen { grid-template-columns: 1fr 1fr; }
    .statement__grid { grid-template-columns: 5rem 1fr; gap: var(--space-m); }
  }
  @media (max-width: 32rem) {
    .stappen { grid-template-columns: 1fr; }
    .statement__grid { grid-template-columns: 1fr; }
    .statement__blokken { width: 4rem; }
    .panels__maatwerk { padding: var(--space-m); }
  }
</style>
