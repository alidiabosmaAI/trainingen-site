---
import Base from '../layouts/Base.astro';
---

<Base title="Over" description="Over Alidia Bosma.">
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">Over</p>
      <h1>Alidia Bosma</h1>
      <p class="lead">Expert in algoritmisch bestuur en AI-geletterdheid.</p>
      <p>
        [Voorbeeldtekst: vertel hier over je achtergrond, ervaring met algoritmisch bestuur, opdrachtgevers en wat je
        drijft. Een foto maakt het persoonlijk.]
      </p>
      <h2>Achtergrond</h2>
      <ul>
        <li>[Opleiding / onderzoek]</li>
        <li>[Relevante werkervaring]</li>
        <li>[Publicaties, lezingen, netwerken]</li>
      </ul>
    </div>
  </section>
</Base>
