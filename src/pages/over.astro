---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import { site } from '../config';
import { url } from '../lib/url';
---

<Base title="Over" description={`Over ${site.name}.`}>
  <section class="section">
    <div class="container over">
      <div class="over__foto"><Foto /></div>
      <div class="prose">
        <h1>{site.name}</h1>
        <p class="intro">[Eén zin over wie je bent en wat je doet.]</p>
        <p>
          [Voorbeeldtekst: je achtergrond, ervaring met algoritmisch bestuur, opdrachtgevers en wat je drijft.]
        </p>
        <p><a class="button" href={url('contact/')}>Neem contact op</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .over { display: grid; grid-template-columns: 18rem 1fr; gap: var(--space-l); align-items: start; }
  @media (max-width: 48rem) { .over { grid-template-columns: 1fr; gap: var(--space-m); } .over__foto { max-width: 14rem; } }
</style>
