---
import Base from '../layouts/Base.astro';
import Merk from '../components/Merk.astro';
import { site } from '../config';
import { url } from '../lib/url';
---

<Base title="Over" description={`Over ${site.name}.`}>
  <section class="section">
    <div class="container over">
      <div class="over__visual">
        <Merk fotoplek />
      </div>
      <div class="prose">
        <p class="label" style="--label-kleur: var(--olijf)">Over</p>
        <h1>{site.name}</h1>
        <p class="intro">Expert in algoritmisch bestuur en AI-geletterdheid.</p>
        <p>
          [Voorbeeldtekst: vertel hier over je achtergrond, ervaring met algoritmisch bestuur, opdrachtgevers en wat
          je drijft.]
        </p>
        <h2>Achtergrond</h2>
        <ul>
          <li>[Opleiding / onderzoek]</li>
          <li>[Relevante werkervaring]</li>
          <li>[Publicaties, lezingen, netwerken]</li>
        </ul>
        <p><a class="button button--accent" href={url('contact/')}>Kennismaken?</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .over { display: grid; grid-template-columns: 1fr 1.5fr; gap: var(--space-xl); align-items: start; }
  .over__visual { max-width: 24rem; }
  @media (max-width: 56rem) { .over { grid-template-columns: 1fr; gap: var(--space-l); } .over__visual { max-width: 16rem; } }
</style>
