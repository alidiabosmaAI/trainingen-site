---
import Base from '../layouts/Base.astro';
import Tegels from '../components/Tegels.astro';
import { site } from '../config';
import { url } from '../lib/url';
---

<Base title="Over" description={`${site.name}: bestuurskundige en docent, gespecialiseerd in AI-geletterdheid in de publieke sector.`}>
  <section class="section">
    <div class="container over">
      <div class="over__visual">
        <Tegels variant="b" />
      </div>
      <div class="prose">
        <p class="label" style="--label-kleur: var(--olijf)">Over</p>
        <h1>{site.name}</h1>
        <p class="intro">
          Bestuurskundige en docent. Ik help publieke organisaties om AI te begrijpen en er verantwoord mee te
          werken.
        </p>
        <p>
          Ik ben altijd geboeid geweest door de vraag waarom beleid is zoals het is, en waar het beter kan. Vaak gaat
          het mis op de plek waar beleid en uitvoering elkaar niet goed raken. Met de komst van AI en algoritmes in
          het openbaar bestuur is die vraag urgenter dan ooit: wie begrijpt nog hoe een besluit tot stand komt, en
          wie is ervoor verantwoordelijk?
        </p>
        <p>
          Voor mijn master Management van de Publieke Sector aan de Universiteit Leiden schreef ik mijn scriptie over
          AI-geletterdheid onder startende ambtenaren, en over hoe je die al tijdens de opleiding aan studenten kunt
          aanleren. Die kennis gebruik ik nu in mijn trainingen: wat moeten medewerkers echt weten en kunnen, en hoe
          leer je dat zo dat het blijft hangen?
        </p>
        <p>
          Bij De Haagse Hogeschool doceer ik Bestuurskunde en Overheidsmanagement. In de toetscommissie houd ik me
          specifiek bezig met AI in het onderwijs. Ik weet dus uit de praktijk hoe je ingewikkelde onderwerpen
          toegankelijk maakt, liefst met werkvormen waarin deelnemers zelf aan de slag gaan in plaats van te luisteren
          naar een lange presentatie.
        </p>
        <p>
          Daarvoor werkte ik als beleidsadviseur bij de gemeenten Zoetermeer en Westland, onder meer als
          netwerkregisseur in het sociaal domein. Ik ken het openbaar bestuur dus ook van binnenuit.
        </p>

        <h2>Achtergrond</h2>
        <ul>
          <li>MSc Management van de Publieke Sector, Universiteit Leiden. Scriptie over AI-geletterdheid onder startende ambtenaren</li>
          <li>BA Bestuurskunde en Overheidsmanagement, De Haagse Hogeschool</li>
          <li>Docent Bestuurskunde en Overheidsmanagement, De Haagse Hogeschool (sinds 2022)</li>
          <li>Lid toetscommissie, met als aandachtspunt AI in het onderwijs</li>
          <li>Beleidsadviseur en netwerkregisseur Wmo/Welzijn, gemeente Zoetermeer</li>
          <li>Beleidsmedewerker sociaal domein, gemeente Westland</li>
          <li>Didactisch gecertificeerd: Basiskwalificatie Examinering (BKE) en Basis Didactische Bekwaamheid (BDB)</li>
        </ul>
        <p><a class="button button--accent" href={url('contact/')}>Kennismaken?</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .over { display: grid; grid-template-columns: 1fr 1.5fr; gap: var(--space-xl); align-items: start; }
  .over__visual { max-width: 24rem; }
  @media (max-width: 56rem) { .over { grid-template-columns: 1fr; gap: var(--space-l); } .over__visual { max-width: 16rem; } }
</style>
