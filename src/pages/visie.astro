---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Artikel from '../components/Artikel.astro';
import { url } from '../lib/url';
import { themaKleur } from '../lib/thema';

const trainingen = await getCollection('trainingen');
const trainingVoor = (thema: string) => trainingen.find((t) => t.data.thema === thema);

const uitgangspunten = [
  {
    titel: 'AI-geletterdheid is voor iedere ambtenaar',
    tekst:
      'Algoritmes veranderen de relatie tussen overheid en burger. Begrijpen hoe ze werken is daarom geen specialisme voor IT, maar een basiscompetentie voor iedereen die beleid maakt, uitvoert of leidinggeeft.',
  },
  {
    titel: 'ChatGPT is het topje van de ijsberg',
    tekst:
      'Generatieve AI zette het onderwerp op de agenda, maar de overheid werkt al tientallen jaren met rekenregels en beslisbomen. Wat mensen al gebruiken is de ingang naar die bredere vragen.',
  },
  {
    titel: 'Een algoritme is nooit neutraal',
    tekst:
      'Een algoritme is een beleidsinstrument. In elke rekenregel en elke dataset zitten keuzes en aannames. Wie dat ziet, kan ze bespreken en bijsturen.',
  },
  {
    titel: 'Waarden gaan voor snelheid',
    tekst:
      'Sneller en goedkoper is begrijpelijk. Maar gelijke behandeling, privacy, rechtszekerheid en de menselijke maat mogen daar niet voor wijken. De vraag is niet alleen of het werkt, maar ook of het eerlijk is.',
  },
  {
    titel: 'De mens blijft verantwoordelijk',
    tekst:
      'Menselijke tussenkomst werkt alleen als iemand de tijd, kennis en het mandaat heeft om af te wijken van een systeemadvies. Anders wordt het een vinkje.',
  },
  {
    titel: 'Leren landt in de organisatie',
    tekst:
      'Kennis alleen is niet genoeg. Zonder tijd, een duidelijke visie en collega’s die de brug slaan tussen techniek en beleid blijft het geleerde liggen.',
  },
];
const voorbeelden = [
  {
    soort: 'Beslisboom',
    tekst:
      'Een rekenregel bepaalt wie recht heeft op een toeslag. Waar ligt de grens, en wat gebeurt er met wie er net buiten valt?',
    waarden: ['rechtszekerheid', 'menselijke maat'],
    kleur: 'var(--oker)',
    vorm: '100% 0 0 0',
  },
  {
    soort: 'Zelflerend algoritme',
    tekst:
      'Een risicomodel leert van eerdere controles wie extra gecontroleerd moet worden. Waren die controles scheef, dan leert het model dat ook.',
    waarden: ['gelijke behandeling', 'doelmatigheid'],
    kleur: 'var(--ink)',
    vorm: '0 0 100% 0',
  },
  {
    soort: 'Generatieve AI',
    tekst:
      'Een taalmodel vat bezwaarschriften samen. Wat laat het weg, en wat gebeurt er met de persoonsgegevens die je invoert?',
    waarden: ['transparantie', 'privacy'],
    kleur: 'var(--denim)',
    vorm: '50%',
  },
];

const kleuren = ['var(--oker)', 'var(--salie)', 'var(--perzik)', 'var(--hemel)', 'var(--oker)', 'var(--salie)'];

const niveaus = [
  {
    rol: 'De professional als gebruiker',
    tekst: 'Werkt met AI en algoritmes, en weet wanneer een uitkomst kritisch bevraagd moet worden.',
    thema: 'Basistraining',
  },
  {
    rol: 'De adviseur als beoordelaar en opdrachtgever',
    tekst: 'Beoordeelt systemen aan de hand van publieke waarden en houdt de regie, ook richting IT en leveranciers.',
    thema: 'Verdieping voor adviseurs',
  },
  {
    rol: 'De leidinggevende als richtinggever',
    tekst: 'Geeft richting, maakt ruimte om te leren en organiseert tegenspraak wanneer het schuurt.',
    thema: 'Voor leidinggevenden',
  },
];
---

<Base title="Visie" description="Mijn visie op AI-geletterdheid en algoritmisch bestuur in de publieke sector.">
  <section class="section">
    <div class="container kop">
      <div>
        <p class="label" style="--label-kleur: var(--olijf)">Visie</p>
        <h1>AI-geletterdheid is ambtelijk vakmanschap</h1>
        <p class="intro">
          Of het nu gaat om een beslisboom, een zelflerend model of ChatGPT: elke toepassing maakt keuzes die burgers
          raken. Dat vraagt om ambtenaren die begrijpen wat er gebeurt, de juiste vragen stellen en de rechtsstaat
          bewaken.
        </p>
      </div>
      <Artikel kop="Wat is AI-geletterdheid?" bron="Werkdefinitie uit mijn onderzoek">
        <p>
          De kennis, vaardigheden en houding die nodig zijn om AI-systemen in het openbaar bestuur
          <mark>geïnformeerd, kritisch en juridisch verantwoord</mark> te gebruiken, en de daarbij behorende kansen,
          risico’s en mogelijke schade te herkennen.
        </p>
      </Artikel>
    </div>
  </section>

  <section class="section section--papier">
    <div class="container">
      <h2>Waarden in de techniek</h2>
      <p class="intro">
        Publieke waarden zijn de dingen die we van een goede overheid verwachten: gelijke behandeling, privacy,
        rechtszekerheid, transparantie, de menselijke maat, maar ook doelmatigheid en betrouwbaarheid.
      </p>
      <p class="toelichting">
        Bestuurskundigen tellen er tientallen (Jørgensen &amp; Bozeman, 2007). Ze botsen geregeld met elkaar, en elke
        technologie maakt daarin een keuze. Drie voorbeelden:
      </p>
      <ul class="voorbeelden">
        {
          voorbeelden.map((v) => (
            <li>
              <span class="voorbeelden__vorm" style={`background: ${v.kleur}; border-radius: ${v.vorm}`} aria-hidden="true" />
              <h3>{v.soort}</h3>
              <p>{v.tekst}</p>
              <ul class="voorbeelden__waarden" aria-label="Waarden die hier spelen">
                {v.waarden.map((w) => <li>{w}</li>)}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Zes uitgangspunten</h2>
      <ol class="punten">
        {
          uitgangspunten.map((u, i) => (
            <li>
              <span class="punten__nr" style={`background: ${kleuren[i]}`} aria-hidden="true">
                {i + 1}
              </span>
              <div>
                <h3>{u.titel}</h3>
                <p>{u.tekst}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--papier">
    <div class="container">
      <p class="label" style="--label-kleur: var(--koper)">Van visie naar aanbod</p>
      <h2>Drie rollen, drie trainingen</h2>
      <p class="intro">Iedereen in de organisatie heeft een eigen rol bij verantwoord gebruik van AI.</p>
      <ul class="niveaus">
        {
          niveaus.map((n) => {
            const t = trainingVoor(n.thema);
            const k = themaKleur[n.thema];
            return (
              <li>
                <span class="niveaus__vorm" style={`background: ${k.accent}; border-radius: ${k.vorm}`} aria-hidden="true" />
                <h3>{n.rol}</h3>
                <p>{n.tekst}</p>
                {t && (
                  <p class="niveaus__link">
                    <a href={url(`aanbod/${t.id}/`)}>{t.data.titel} →</a>
                  </p>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
  <section class="section">
    <div class="container waaromnu">
      <div>
        <p class="label" style="--label-kleur: var(--oker)">Waarom nu</p>
        <h2>AI-geletterdheid is verplicht</h2>
        <p class="intro">
          Sinds 2 februari 2025 moeten organisaties die AI inzetten zorgen dat hun medewerkers voldoende
          AI-geletterd zijn. Dat geldt ook voor overheden en semi-publieke organisaties.
        </p>
      </div>
      <Artikel kop="Artikel 4 · AI-geletterdheid" bron="AI-verordening (EU) 2024/1689, van toepassing sinds 2 februari 2025">
        <p>
          Aanbieders en gebruiksverantwoordelijken van AI-systemen nemen maatregelen om, zoveel als mogelijk, te
          zorgen voor een <mark>toereikend niveau van AI-geletterdheid</mark> bij hun personeel en andere personen
          die namens hen AI-systemen exploiteren en gebruiken […]
        </p>
      </Artikel>
    </div>
  </section>
</Base>

<style>
  .kop { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-xl); align-items: center; }
  .kop h1 { max-width: 16ch; }

  .punten {
    list-style: none;
    margin: var(--space-l) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-l) var(--space-xl);
  }
  .punten li { display: grid; grid-template-columns: 3.25rem 1fr; gap: var(--space-m); align-items: start; }
  .punten__nr {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius);
    font-weight: 800;
    font-size: var(--step-1);
  }
  .punten h3 { font-size: var(--step-1); margin-bottom: var(--space-xs); }
  .punten p { margin: 0; }

  .toelichting { max-width: 60ch; margin-top: var(--space-s); }
  .voorbeelden {
    list-style: none;
    margin: var(--space-l) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-m);
  }
  .voorbeelden > li {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border-radius: var(--radius);
    padding: var(--space-m);
  }
  .voorbeelden__vorm { display: block; width: 3rem; height: 3rem; margin-bottom: var(--space-m); }
  .voorbeelden h3 { font-size: var(--step-1); margin-bottom: var(--space-xs); }
  .voorbeelden__waarden { list-style: none; margin: auto 0 0; padding: var(--space-s) 0 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .voorbeelden__waarden li { background: var(--salie); border-radius: var(--radius); padding: 0.2em 0.7em; font-size: var(--step--1); font-weight: 650; }

  .waaromnu { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-xl); align-items: center; }
  .niveaus {
    list-style: none;
    margin: var(--space-l) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-m);
  }
  .niveaus li {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--lijn);
    border-radius: var(--radius);
    padding: var(--space-m);
    background: var(--white);
  }
  .niveaus__vorm { display: block; width: 3rem; height: 3rem; margin-bottom: var(--space-m); }
  .niveaus h3 { font-size: var(--step-1); }
  .niveaus__link { margin: auto 0 0; padding-top: var(--space-s); font-weight: 700; }
  .niveaus__link a { text-decoration: none; }
  .niveaus__link a:hover { text-decoration: underline; }

  @media (max-width: 56rem) {
    .kop, .punten, .waaromnu { grid-template-columns: 1fr; gap: var(--space-l); }
    .niveaus, .voorbeelden { grid-template-columns: 1fr; }
  }
</style>
