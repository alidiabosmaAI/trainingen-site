---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import Werkwijze from '../components/Werkwijze.astro';
---

<Base title="Werkwijze" description="Hoe een traject verloopt: van kennismaking tot evaluatie.">
  <section class="section">
    <div class="container">
      <p class="label" style="--label-kleur: var(--olijf)">Werkwijze</p>
      <h1>Van vraag tot vervolg</h1>
      <p class="intro">Elke training stem ik af op jullie organisatie, in een helder proces dat aansluit bij hoe publieke organisaties inkopen en plannen.</p>
      <Werkwijze />
    </div>
  </section>
  <section class="section section--papier">
    <div class="container prose">
      <h2>Inkoop en facturatie</h2>
      <ul>
        <li>Offerte met vaste prijs per groep of per deelnemer</li>
        <li>Facturatie via e-factuur mogelijk</li>
        <li>Algemene voorwaarden op aanvraag</li>
      </ul>
      <p><a class="button" href={url('contact/')}>Plan een kennismaking</a></p>
    </div>
  </section>
</Base>
