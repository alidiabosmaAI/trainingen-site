---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';

const stappen = [
  { titel: 'Kennismaking', tekst: 'We bespreken jullie vraag, de doelgroep en waar jullie staan met AI en algoritmes.' },
  { titel: 'Voorstel op maat', tekst: 'Je ontvangt een offerte met programma, planning en een vaste prijs, passend bij jullie inkoopproces.' },
  { titel: 'Training', tekst: 'Interactieve sessies met casussen uit jullie eigen praktijk, op locatie of online.' },
  { titel: 'Evaluatie', tekst: 'We kijken samen terug en bespreken eventuele vervolgstappen.' },
];
---

<Base title="Werkwijze" description="Hoe een traject verloopt: van kennismaking tot evaluatie.">
  <section class="section">
    <div class="container">
      <h1>Werkwijze</h1>
      <p class="intro">Een helder proces dat aansluit bij hoe publieke organisaties inkopen en plannen.</p>
      <ol class="stappen">
        {stappen.map((s) => (
          <li>
            <h2>{s.titel}</h2>
            <p>{s.tekst}</p>
          </li>
        ))}
      </ol>
      <p class="zacht">Facturatie via e-factuur is mogelijk. Algemene voorwaarden op aanvraag.</p>
      <a class="button" href={url('contact/')}>Plan een kennismaking</a>
    </div>
  </section>
</Base>

<style>
  .stappen { margin: var(--space-l) 0; padding-left: 1.4em; display: grid; gap: var(--space-m); max-width: 40rem; }
  .stappen li::marker { font-family: var(--font-serif); font-size: var(--step-1); }
  .stappen h2 { font-size: var(--step-1); margin-bottom: 0.4rem; }
  .stappen p { margin: 0; }
  .zacht { margin-bottom: var(--space-m); }
</style>
