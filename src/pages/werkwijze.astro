---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';

const stappen = [
  { titel: 'Kennismaking', tekst: 'We bespreken jullie vraag, de doelgroep en waar jullie staan met AI en algoritmes.' },
  { titel: 'Voorstel op maat', tekst: 'Je ontvangt een offerte met programma, planning en een vaste prijs. Geschikt voor jullie inkoopproces.' },
  { titel: 'Training', tekst: 'Interactieve sessies met spelvormen en casussen uit jullie eigen praktijk, op locatie of online.' },
  { titel: 'Evaluatie & borging', tekst: 'We evalueren de opbrengst en kijken samen naar vervolgstappen en naslagmateriaal.' },
];
---

<Base title="Werkwijze" description="Hoe een traject verloopt: van kennismaking tot evaluatie.">
  <section class="section">
    <div class="container">
      <p class="label" style="--label-kleur: var(--olijf)">Werkwijze</p>
      <h1>Van vraag tot vervolg</h1>
      <p class="intro">Een helder proces dat aansluit bij hoe publieke organisaties inkopen en plannen.</p>
      <ol class="stappen">
        {stappen.map((s, i) => (
          <li>
            <span class="stappen__nr" aria-hidden="true">{i + 1}</span>
            <div>
              <h2>{s.titel}</h2>
              <p>{s.tekst}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section class="section section--papier">
    <div class="container prose">
      <h2>Inkoop en facturatie</h2>
      <ul>
        <li>Offerte met vaste prijs per groep of per deelnemer</li>
        <li>Facturatie via e-factuur mogelijk</li>
        <li>Algemene voorwaarden op aanvraag</li>
      </ul>
      <p><a class="button" href={url('contact/')}>Plan een kennismaking</a></p>
    </div>
  </section>
</Base>

<style>
  .stappen { list-style: none; padding: 0; margin: var(--space-l) 0 0; display: grid; gap: var(--space-m); max-width: 46rem; }
  .stappen li { display: grid; grid-template-columns: 3.5rem 1fr; gap: var(--space-m); align-items: start; }
  .stappen__nr { font-weight: 800; font-size: var(--step-3); line-height: 1; color: var(--knop-accent); }
  .stappen h2 { font-size: var(--step-1); margin-bottom: var(--space-xs); }
  .section--papier { margin-top: 0; }
</style>
