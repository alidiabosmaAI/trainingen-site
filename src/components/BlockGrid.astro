---
// Raster van vier gekleurde vlakken. Eén vlak kan een foto bevatten;
// zolang er geen foto is, staat daar een rustige plaatshouder.
interface Props {
  kleuren?: [string, string, string, string];
  foto?: string;
  fotoAlt?: string;
  fotoVak?: 0 | 1 | 2 | 3;
}

const {
  kleuren = ['var(--oranje)', 'var(--perzik)', 'var(--mint)', 'var(--ink)'],
  foto,
  fotoAlt = '',
  fotoVak = 1,
} = Astro.props;
---

<div class="blocks" aria-hidden={foto ? undefined : 'true'}>
  {
    kleuren.map((kleur, i) =>
      i === fotoVak && foto ? (
        <img class="blocks__vak" src={foto} alt={fotoAlt} />
      ) : (
        <div class="blocks__vak" style={`background: ${kleur}`}>
          {i === fotoVak && <span class="blocks__placeholder">Foto volgt</span>}
        </div>
      ),
    )
  }
</div>

<style>
  .blocks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    aspect-ratio: 1;
    width: 100%;
  }
  .blocks__vak {
    aspect-ratio: 1;
    width: 100%;
    object-fit: cover;
    display: grid;
    place-items: center;
  }
  .blocks__placeholder {
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.55;
  }
</style>
