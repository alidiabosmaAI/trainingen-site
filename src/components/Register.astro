---
// Aanbod als register: één regel per training, zoals een overzicht in een beleidsdocument.
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';
import { themaKleur } from '../lib/thema';

interface Props {
  trainingen: CollectionEntry<'trainingen'>[];
}

const { trainingen } = Astro.props;
---

<ol class="register">
  {
    trainingen.map((t, i) => (
      <li class="register__rij" style={`--lijn-kleur: ${themaKleur[t.data.thema].lijn}`}>
        <span class="register__nr" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <div class="register__hoofd">
          <p class="register__thema">{t.data.thema}</p>
          <h3>
            <a href={url(`aanbod/${t.id}/`)}>{t.data.titel}</a>
          </h3>
          <p class="register__samenvatting">{t.data.samenvatting}</p>
        </div>
        <dl class="register__meta">
          <div><dt>Duur</dt><dd>{t.data.duur}</dd></div>
          <div><dt>Vorm</dt><dd>{t.data.vorm.join(', ')}</dd></div>
          <div><dt>Groep</dt><dd>{t.data.groepsgrootte}</dd></div>
        </dl>
        <span class="register__pijl" aria-hidden="true">→</span>
      </li>
    ))
  }
</ol>

<style>
  .register { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--lijn); }
  .register__rij {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 15rem 2rem;
    gap: var(--space-m);
    align-items: start;
    padding: var(--space-m) var(--space-s) var(--space-m) 0;
    border-top: 1px solid var(--lijn);
    transition: background 0.15s ease;
  }
  .register__rij::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    width: 3rem;
    height: 3px;
    background: var(--lijn-kleur);
  }
  .register__rij:hover { background: var(--white); }
  .register__nr { font-family: var(--font-serif); font-size: var(--step-1); color: var(--ink-soft); }
  .register__thema {
    font-size: var(--step--1);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.3rem;
    color: var(--ink-soft);
  }
  .register h3 { margin-bottom: 0.4rem; }
  .register h3 a { color: var(--ink); text-decoration: none; }
  .register h3 a::after { content: ''; position: absolute; inset: 0; }
  .register__rij:hover h3 a { text-decoration: underline; text-decoration-color: var(--lijn-kleur); }
  .register h3 a:focus-visible { outline: none; }
  .register__rij:focus-within { outline: 3px solid var(--oranje); outline-offset: 2px; }
  .register__samenvatting { margin: 0; color: var(--ink-soft); max-width: 55ch; }
  .register__meta { margin: 0.2rem 0 0; display: grid; gap: 0.35rem; font-size: var(--step--1); }
  .register__meta div { display: grid; grid-template-columns: 4rem 1fr; }
  .register__meta dt { font-weight: 650; }
  .register__meta dd { margin: 0; }
  .register__pijl { font-size: var(--step-1); color: var(--roest); transition: transform 0.15s ease; }
  .register__rij:hover .register__pijl { transform: translateX(4px); }

  @media (max-width: 52rem) {
    .register__rij { grid-template-columns: 2.5rem minmax(0, 1fr); gap: var(--space-s); }
    .register__meta { grid-column: 2; }
    .register__pijl { display: none; }
  }
</style>
