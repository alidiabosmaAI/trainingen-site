---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { nav } from '../config';
import { url } from '../lib/url';

const current = Astro.url.pathname;
const trainingen = (await getCollection('trainingen')).sort((a, b) => a.data.volgorde - b.data.volgorde);
---

<header class="header">
  <div class="container header__inner">
    <a href={url()} class="header__home" aria-label="Naar de homepage">
      <Logo />
    </a>

    <button class="header__toggle" aria-expanded="false" aria-controls="hoofdmenu">Menu</button>

    <nav id="hoofdmenu" class="header__nav" aria-label="Hoofdmenu">
      <ul class="menu">
        {
          nav.map((item) => {
            const href = url(item.href);
            const active = current.startsWith(href);
            const isAanbod = item.href === 'aanbod/';
            return (
              <li class:list={['menu__item', { 'menu__item--sub': isAanbod }]}>
                <a href={href} aria-current={active ? 'page' : undefined}>
                  {item.label}
                </a>
                {isAanbod && (
                  <ul class="submenu">
                    {trainingen.map((t) => (
                      <li>
                        <a href={url(`aanbod/${t.id}/`)}>{t.data.titel}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.header__toggle');
  const header = document.querySelector('.header');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    header?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: 6rem;
  }
  .header__home { text-decoration: none; }

  .menu { list-style: none; display: flex; gap: var(--space-m); margin: 0; padding: 0; }
  .menu__item { position: relative; }
  .menu__item > a { display: block; padding-block: 1rem; text-decoration: none; }
  .menu__item > a:hover,
  .menu__item > a[aria-current='page'] { text-decoration: underline; }

  .submenu {
    list-style: none;
    margin: 0;
    padding: 0.75rem 0;
    position: absolute;
    top: 100%;
    left: -1.25rem;
    width: 22rem;
    background: var(--white);
    border-radius: 4px;
    box-shadow: 0 10px 30px -12px rgb(58 33 64 / 0.25);
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.15s ease;
    z-index: 10;
  }
  .menu__item--sub:hover .submenu,
  .menu__item--sub:focus-within .submenu { visibility: visible; opacity: 1; }
  .submenu a { display: block; padding: 0.5rem 1.25rem; text-decoration: none; line-height: 1.4; }
  .submenu a:hover { background: var(--groen); }

  .header__toggle {
    display: none;
    font: inherit;
    color: var(--ink);
    background: none;
    border: 0;
    padding: 0.5rem 0;
    text-decoration: underline;
    text-underline-offset: 0.22em;
    cursor: pointer;
  }

  @media (max-width: 48rem) {
    .header__inner { flex-wrap: wrap; min-height: 5rem; }
    .header__toggle { display: block; }
    .header__nav { display: none; flex-basis: 100%; padding-bottom: var(--space-m); }
    .header.is-open .header__nav { display: block; }
    .menu { flex-direction: column; gap: 0; }
    .menu__item > a { padding-block: 0.6rem; font-size: var(--step-1); font-family: var(--font-serif); }
    .submenu {
      position: static;
      width: auto;
      visibility: visible;
      opacity: 1;
      box-shadow: none;
      background: none;
      padding: 0 0 0.5rem;
    }
    .submenu a { padding: 0.35rem 0 0.35rem 1rem; color: var(--ink-soft); }
  }
</style>
