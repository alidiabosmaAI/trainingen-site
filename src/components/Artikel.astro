---
// Citaat uit wet- of regelgeving, vormgegeven als uittreksel.
interface Props {
  bron: string;
  kop: string;
}

const { bron, kop } = Astro.props;
---

<figure class="artikel">
  <figcaption>
    <span class="artikel__kop">{kop}</span>
    <span class="artikel__bron">{bron}</span>
  </figcaption>
  <blockquote>
    <slot />
  </blockquote>
</figure>

<style>
  .artikel {
    margin: 0;
    background: var(--white);
    border-radius: 4px;
    padding: var(--space-m);
    box-shadow: 0 10px 30px -14px rgb(58 33 64 / 0.2);
  }
  figcaption { display: grid; gap: 0.1rem; margin-bottom: var(--space-s); }
  .artikel__kop { font-family: var(--font-serif); font-size: var(--step-1); }
  .artikel__bron { font-size: var(--step--1); color: var(--ink-soft); }
  blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.65;
    font-style: italic;
  }
  blockquote :global(p) { margin: 0 0 var(--space-s); }
  blockquote :global(p:last-child) { margin: 0; }
  blockquote :global(mark) { background: var(--groen); color: inherit; padding: 0 0.15em; }
</style>
