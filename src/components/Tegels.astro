---
// Compositie van tegels in een raster van 3 x 3: een grote fotoplek met
// daaromheen kleinere tegels, waarvan sommige een kwartcirkel of cirkel zijn.
// Zolang er geen foto is, staat er een rustige plaatshouder.
interface Props {
  foto?: string;
  fotoAlt?: string;
  // Welk deel van de foto zichtbaar blijft bij bijsnijden, bijv. 'center 20%'.
  fotoPositie?: string;
  variant?: 'a' | 'b';
}

const { foto, fotoAlt = '', fotoPositie = 'center', variant = 'a' } = Astro.props;
const fotoSrc = foto && `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${foto.replace(/^\//, '')}`;

// Per tegel: kleur en vorm. Vormen: vierkant, cirkel, leeg, en kwartcirkels met de ronding
// linksboven (kwart-lb), rechtsboven (kwart-rb), rechtsonder (kwart-ro) of linksonder (kwart-lo).
const composities = {
  a: [
    { kleur: 'var(--oker)', vorm: 'kwart-lb' },
    { kleur: 'var(--salie)', vorm: 'vierkant' },
    { kleur: 'var(--denim)', vorm: 'cirkel' },
    { kleur: 'var(--ink)', vorm: 'kwart-ro' },
    { kleur: 'transparent', vorm: 'leeg' },
  ],
  // Gespiegelde versie van a: dezelfde kleuren en vormen, de foto rechts.
  b: [
    { kleur: 'var(--oker)', vorm: 'kwart-rb' },
    { kleur: 'var(--salie)', vorm: 'vierkant' },
    { kleur: 'transparent', vorm: 'leeg' },
    { kleur: 'var(--ink)', vorm: 'kwart-lo' },
    { kleur: 'var(--denim)', vorm: 'cirkel' },
  ],
};
const tegels = composities[variant];
---

<div class:list={['tegels', `tegels--${variant}`]} aria-hidden={foto ? undefined : 'true'}>
  {
    foto ? (
      <img class="tegels__foto" src={fotoSrc} alt={fotoAlt} style={`object-position: ${fotoPositie}`} />
    ) : (
      <div class="tegels__foto tegels__foto--leeg">
        <span>Foto volgt</span>
      </div>
    )
  }
  {tegels.map((t) => <span class={`tegel tegel--${t.vorm}`} style={`background: ${t.kleur}`} />)}
</div>

<style>
  .tegels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 0.6rem;
    aspect-ratio: 1;
    width: 100%;
  }
  .tegels__foto {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .tegels--b .tegels__foto { grid-column: 2 / 4; }
  .tegels__foto--leeg {
    background: var(--zand);
    display: grid;
    place-items: center;
  }
  .tegels__foto--leeg span {
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    opacity: 0.6;
  }
  .tegel { display: block; aspect-ratio: 1; border-radius: var(--radius); }
  .tegel--kwart-lb { border-radius: 100% 0 0 0; }
  .tegel--kwart-ro { border-radius: 0 0 100% 0; }
  .tegel--kwart-rb { border-radius: 0 100% 0 0; }
  .tegel--kwart-lo { border-radius: 0 0 0 100%; }
  .tegel--cirkel { border-radius: 50%; }
</style>
