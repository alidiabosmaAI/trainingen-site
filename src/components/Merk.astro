---
// Het beeldmerk uit het logo, op elke grootte: kwartcirkel, cirkel, tegel, kwartcirkel.
// - Standaard in de logokleuren.
// - Met `accent` wordt één vorm de themakleur en de rest wit (voor op een gekleurd vlak).
// - Met `fotoplek` wordt de tegel (linksonder) een plek voor een foto.
interface Props {
  accent?: string;
  fotoplek?: boolean;
  foto?: string;
  fotoAlt?: string;
}

const { accent, fotoplek = false, foto, fotoAlt = '' } = Astro.props;

const kleuren = accent
  ? [accent, 'var(--white)', 'var(--white)', 'var(--white)']
  : ['var(--terracotta)', 'var(--oker)', 'var(--salie)', 'var(--ink)'];
---

<div class="merk" aria-hidden={foto ? undefined : 'true'}>
  <span class="merk__vorm merk__vorm--kwart-lb" style={`background: ${kleuren[0]}`}></span>
  <span class="merk__vorm merk__vorm--cirkel" style={`background: ${kleuren[1]}`}></span>
  {
    foto ? (
      <img class="merk__vorm merk__vorm--tegel" src={foto} alt={fotoAlt} />
    ) : fotoplek ? (
      <span class="merk__vorm merk__vorm--tegel merk__foto-leeg">Foto volgt</span>
    ) : (
      <span class="merk__vorm merk__vorm--tegel" style={`background: ${kleuren[2]}`}></span>
    )
  }
  <span class="merk__vorm merk__vorm--kwart-ro" style={`background: ${kleuren[3]}`}></span>
</div>

<style>
  .merk {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6%;
    aspect-ratio: 1;
    width: 100%;
  }
  .merk__vorm { display: block; aspect-ratio: 1; width: 100%; height: 100%; object-fit: cover; }
  .merk__vorm--kwart-lb { border-radius: 100% 0 0 0; }
  .merk__vorm--cirkel { border-radius: 50%; }
  .merk__vorm--tegel { border-radius: 10%; }
  .merk__vorm--kwart-ro { border-radius: 0 0 100% 0; }
  .merk__foto-leeg {
    display: grid;
    place-items: center;
    background: var(--zand);
    font-size: var(--step--1);
    color: var(--ink);
    opacity: 0.75;
  }
</style>
