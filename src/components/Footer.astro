---
import { site, nav } from '../config';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p>© {year} {site.name}</p>
    <ul>
      {nav.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
      <li><a href={url('privacy/')}>Privacy</a></li>
      <li><a href={url('toegankelijkheid/')}>Toegankelijkheid</a></li>
    </ul>
  </div>
  {
    (site.kvk || site.crkbo) && (
      <p class="container footer__legal">
        {site.kvk && <span>KvK {site.kvk}</span>}
        {site.crkbo && <span>CRKBO-geregistreerd</span>}
      </p>
    )
  }
</footer>

<style>
  .footer { padding-block: var(--space-l); font-size: var(--step--1); color: var(--ink-soft); }
  .footer a { color: var(--ink-soft); text-decoration: none; }
  .footer a:hover { color: var(--ink); text-decoration: underline; }
  .footer__inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-s); }
  .footer p { margin: 0; }
  .footer ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .footer__legal { display: flex; gap: 1.5rem; margin-top: var(--space-s) !important; }
</style>
