---
// Illustratie voor de homepage: een beslisboom in warme kleuren.
// Verwijst naar algoritmisch besluiten, zonder robots of "AI-clichés".
---

<figure class="tree" aria-hidden="true">
  <svg viewBox="0 0 420 380" role="presentation">
    <defs>
      <pattern id="dots" width="18" height="18" patternUnits="userSpaceOnUse">
        <circle cx="2" cy="2" r="1.3" fill="var(--line)" />
      </pattern>
    </defs>
    <rect x="0" y="0" width="420" height="380" rx="22" fill="url(#dots)" />

    <g fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round">
      <path d="M210 78 C210 120 110 110 110 160" />
      <path d="M210 78 C210 120 310 110 310 160" />
      <path d="M110 205 C110 240 60 240 60 280" />
      <path d="M110 205 C110 240 160 240 160 280" />
      <path d="M310 205 C310 250 310 250 310 280" stroke-dasharray="4 6" />
    </g>

    <g font-family="var(--font-mono)" font-size="12" font-weight="500" text-anchor="middle">
      <rect x="130" y="30" width="160" height="48" rx="24" fill="var(--ink)" />
      <text x="210" y="59" fill="var(--paper)">BESLUIT</text>

      <rect x="40" y="160" width="140" height="45" rx="12" fill="var(--terracotta)" />
      <text x="110" y="187" fill="var(--ink)">DATA</text>

      <rect x="240" y="160" width="140" height="45" rx="12" fill="var(--saffraan)" />
      <text x="310" y="187" fill="var(--ink)">REGELS</text>

      <circle cx="60" cy="305" r="26" fill="var(--abrikoos)" />
      <text x="60" y="309" fill="var(--ink)">MENS</text>

      <circle cx="160" cy="305" r="26" fill="var(--bosgroen)" />
      <text x="160" y="309" fill="var(--paper)">UITLEG</text>

      <rect x="262" y="280" width="96" height="50" rx="12" fill="var(--pruim)" />
      <text x="310" y="310" fill="var(--paper)">TOETS</text>
    </g>

    <circle cx="370" cy="62" r="14" fill="var(--abrikoos)" />
    <circle cx="44" cy="70" r="8" fill="var(--bosgroen)" />
  </svg>
</figure>

<style>
  .tree { margin: 0; }
  .tree svg { display: block; width: 100%; }
</style>
