---
// Staande foto (4:5). Zonder `src` toont het een rustig lichtgroen vlak.
interface Props {
  src?: string;
  alt?: string;
}

const { src, alt = '' } = Astro.props;
---

{
  src ? (
    <img class="foto" src={src} alt={alt} />
  ) : (
    <div class="foto foto--leeg" aria-hidden="true" />
  )
}

<style>
  .foto { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 4px; }
  .foto--leeg { background: var(--groen); }
</style>
