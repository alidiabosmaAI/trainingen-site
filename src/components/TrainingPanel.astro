---
import type { CollectionEntry } from 'astro:content';
import Facts from './Facts.astro';
import { url } from '../lib/url';
import { themaKleur } from '../lib/thema';

interface Props {
  training: CollectionEntry<'trainingen'>;
}

const { training } = Astro.props;
const d = training.data;
const kleur = themaKleur[d.thema];
---

<article class="panel" style={`--vlak: ${kleur.vlak}; --label-kleur: ${kleur.accent}`}>
  <div class="panel__side">
    <p class="label">{d.thema}</p>
    <div class="panel__blok" aria-hidden="true">
      <span style={`background: ${kleur.accent}`}></span>
      <span></span>
      <span></span>
      <span style="background: var(--white)"></span>
    </div>
  </div>
  <div class="panel__body">
    <h3><a href={url(`aanbod/${training.id}/`)}>{d.titel}</a></h3>
    <p>{d.samenvatting}</p>
    <Facts duur={d.duur} groepsgrootte={d.groepsgrootte} vorm={d.vorm} prijsindicatie={d.prijsindicatie} />
    <p class="panel__more"><a href={url(`aanbod/${training.id}/`)} aria-hidden="true" tabindex="-1">Meer over deze training →</a></p>
  </div>
</article>

<style>
  .panel {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-l);
    background: var(--vlak);
    padding: var(--space-l);
  }
  .panel__blok {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 7rem;
    margin-top: var(--space-m);
  }
  .panel__blok span { aspect-ratio: 1; }
  .panel h3 a { text-decoration: none; }
  .panel h3 a::after { content: ''; position: absolute; inset: 0; }
  .panel:hover h3 a { text-decoration: underline; }
  .panel:focus-within { outline: 3px solid var(--vermiljoen); outline-offset: 3px; }
  .panel h3 a:focus-visible { outline: none; }
  .panel__more { margin: var(--space-m) 0 0; font-weight: 500; }
  .panel__more a { text-decoration: none; }
  @media (max-width: 44rem) {
    .panel { grid-template-columns: 1fr; gap: 0; padding: var(--space-m); }
    .panel__blok { display: none; }
  }
</style>
