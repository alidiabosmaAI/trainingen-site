---
// Tijdelijk woordmerk: kwartcirkels, cirkel en tegel, dezelfde vormtaal als op de rest van de site.
// Op een donkere achtergrond zet je --logo-donker op een lichte kleur.
import { site } from '../config';
---

<span class="logo">
  <svg viewBox="0 0 30 30" width="30" height="30" aria-hidden="true">
    <path d="M0 14 A14 14 0 0 1 14 0 L14 14 Z" fill="var(--koper)" />
    <circle cx="23" cy="7" r="7" fill="var(--oker)" />
    <rect x="0" y="16" width="14" height="14" rx="3" fill="var(--salie)" />
    <path d="M16 16 L30 16 A14 14 0 0 1 16 30 Z" fill="var(--logo-donker, var(--ink))" />
  </svg>
  <span>{site.name}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 750;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    color: currentColor;
  }
</style>
