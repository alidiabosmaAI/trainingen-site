---
// Tijdelijk woordmerk: een raster van vier vlakken, verwijzing naar data en structuur.
import { site } from '../config';
---

<span class="logo">
  <svg viewBox="0 0 28 28" width="28" height="28" aria-hidden="true">
    <rect x="0" y="0" width="14" height="14" fill="var(--oranje)" />
    <rect x="14" y="0" width="14" height="14" fill="var(--lila)" />
    <rect x="0" y="14" width="14" height="14" fill="var(--mint)" />
    <rect x="14" y="14" width="14" height="14" fill="var(--ink)" />
  </svg>
  <span>{site.name}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 650;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    color: currentColor;
  }
</style>
