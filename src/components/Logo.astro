---
// Logo: een stevig huisje waar de zon nieuwsgierig overheen kijkt, met een strak woordmerk.
// De punt op de i van "Leerhuis" is dezelfde oker zon: het speelse detail dat terugkomt.
// Op een donkere achtergrond zet je --logo-donker op wit (zie Footer).
import { site } from '../config';
const [klein, groot] = site.name.split(' ');
---

<span class="logo" role="img" aria-label={site.name}>
  <svg class="logo__merk" viewBox="0 0 40 40" aria-hidden="true">
    <circle cx="29" cy="12" r="6.5" fill="var(--oker)" />
    <path
      d="M17 6 L31 18 L31 35 Q31 37 29 37 L5 37 Q3 37 3 35 L3 18 Z"
      fill="var(--logo-donker, var(--ink))"
      stroke="var(--logo-donker, var(--ink))"
      stroke-width="2"
      stroke-linejoin="round"
    />
  </svg>
  <span class="logo__tekst" aria-hidden="true">
    <span class="logo__klein">{klein}</span>
    <span class="logo__groot">{groot.slice(0, -2)}<span class="logo__i">ı</span>s</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: currentColor;
  }
  .logo__merk { width: 2.3em; height: 2.3em; flex: none; }
  .logo__tekst { display: grid; gap: 0.45em; line-height: 0.95; }
  .logo__klein { font-size: 0.55em; font-weight: 650; letter-spacing: 0.01em; }
  .logo__groot { font-size: 1.25em; }
  .logo__i { position: relative; display: inline-block; }
  .logo__i::after {
    content: '';
    position: absolute;
    left: 105%;
    top: -0.2em;
    width: 0.34em;
    height: 0.34em;
    border-radius: 50%;
    background: var(--oker);
    transform: translateX(-50%);
  }
</style>
