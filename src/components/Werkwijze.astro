---
// De vier stappen van de werkwijze, met daaronder een compacte strook over gamificatie.
import { stappen, spelelementen } from '../lib/werkwijze';
---

<ol class="stappen">
  {
    stappen.map((s, i) => (
      <li>
        <span class="stappen__nr" style={`background: ${s.kleur}`} aria-hidden="true">
          {i + 1}
        </span>
        <h3>{s.titel}</h3>
        <p>{s.tekst}</p>
        <ul class="stappen__krijg" aria-label="Wat je krijgt">
          {s.krijg.map((k) => <li>{k}</li>)}
        </ul>
      </li>
    ))
  }
</ol>

<div class="spel">
  <span class="spel__vorm" aria-hidden="true"></span>
  <p class="spel__tekst">
    <strong>Leren met gamificatie.</strong> Spelelementen maken complexe onderwerpen tastbaar en houden deelnemers actief.
  </p>
  <ul class="spel__lijst" aria-label="Spelelementen">
    {spelelementen.map((e) => <li>{e}</li>)}
  </ul>
</div>

<style>
  .stappen {
    list-style: none;
    margin: var(--space-l) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-m);
  }
  .stappen__nr {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius);
    font-weight: 800;
    font-size: var(--step-1);
    margin-bottom: var(--space-s);
  }
  .stappen h3 { font-size: var(--step-1); margin-bottom: var(--space-xs); }
  .stappen p { margin: 0; }
  .stappen__krijg {
    list-style: none;
    margin: var(--space-s) 0 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    font-size: var(--step--1);
    font-weight: 650;
  }
  .stappen__krijg li { padding-left: 1.4rem; position: relative; }
  .stappen__krijg li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.3em;
    width: 0.35rem;
    height: 0.65rem;
    border: solid var(--ink);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .spel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    margin-top: var(--space-l);
    padding: var(--space-s) var(--space-m);
    background: var(--white);
    border: 1px solid var(--lijn);
    border-radius: var(--radius);
  }
  .spel__vorm { flex: none; width: 2rem; height: 2rem; border-radius: 50%; background: var(--denim); }
  .spel__tekst { margin: 0; flex: 1 1 22rem; }
  .spel__lijst { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .spel__lijst li {
    background: var(--salie);
    border-radius: var(--radius);
    padding: 0.2em 0.7em;
    font-size: var(--step--1);
    font-weight: 650;
  }

  @media (max-width: 56rem) {
    .stappen { grid-template-columns: 1fr 1fr; gap: var(--space-l) var(--space-m); }
  }
  @media (max-width: 32rem) {
    .stappen { grid-template-columns: 1fr; }
  }
</style>
